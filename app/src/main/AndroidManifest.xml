<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hsb"
        tools:targetApi="31">
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ManagerActivity"
            android:exported="true" />
        <activity
            android:name=".ui.CustomerActivity"
            android:exported="true" />
        <activity
            android:name=".ui.ReceptionistActivity"
            android:exported="true" />
        <activity
            android:name=".ui.account.activity.edit_account_activity.EditAccountActivity"
            android:exported="false"
            android:parentActivityName=".ui.ManagerActivity" />
        <activity
            android:name=".ui.employee.activity.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.ManagerActivity" />
        <activity
            android:name=".ui.category.activity.CategoryDetail"
            android:exported="true" />
        <activity
            android:name=".ui.home.activity.edit_order_service_activity.OrderServiceActivity"
            android:exported="true" />
        <activity
            android:name=".ui.room.activity.RoomDetail"
            android:exported="true" />
        <activity
            android:name=".ui.room.activity.edit_room_activity.EditRoomActivity"
            android:exported="true" />
        <activity
            android:name=".ui.customer_history.activity.OrderedServiceDetail"
            android:exported="true" />
        <activity
            android:name=".ui.history.activity.EditOrderedServiceDetail"
            android:exported="true" />
        <activity
            android:name=".ui.auth.activity.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home_customer.activity.edit_order_service_activity.OrderServiceCustomerActivity"
            android:exported="true" />
    </application>
</manifest>