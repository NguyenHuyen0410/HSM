<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginTop="30dp">
        <!--            <ImageButton-->
        <!--                android:id="@+id/image_button"-->
        <!--                android:layout_width="50dp"-->
        <!--                android:layout_height="50dp"-->
        <!--                android:background="@drawable/baseline_arrow_back_24"/>-->
        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <EditText
            style="@style/edit_category_input"
            android:id="@+id/et_name_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edt_bg"
            android:minHeight="48dp"
            android:hint="Tên" />

        <EditText
            style="@style/edit_category_input"
            android:id="@+id/et_img_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edt_bg"
            android:hint="Ảnh (URL)"
            android:inputType="textPassword" />

        <EditText
            style="@style/edit_category_input"
            android:id="@+id/et_description_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edt_bg"
            android:hint="Mô tả" />

        <!--        <Spinner-->
        <!--            android:id="@+id/spinner"-->
        <!--            android:layout_marginLeft="200dp"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:spinnerMode="dropdown">-->

        <!--        </Spinner>-->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Checkbox list will be added here programmatically -->
            <LinearLayout
                android:id="@+id/checkbox_container_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Checkboxes will be added here programmatically -->

            </LinearLayout>

        </ScrollView>

        <Button
            android:id="@+id/btn_delete"
            style="@style/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp"
            android:backgroundTint="#D32317"
            android:text="@string/delete"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_save"
            style="@style/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save"
            android:textColor="@android:color/white" />

    </LinearLayout>
</LinearLayout>