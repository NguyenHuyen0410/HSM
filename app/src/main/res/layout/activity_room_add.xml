<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >


    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="50dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="Tạo mới phòng"
            android:textSize="20sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">


        <EditText
            style="@style/room_update"
            android:id="@+id/et_name_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edt_bg"
            android:minHeight="48dp"
            android:hint="Tên" />


        <EditText
            style="@style/room_update"
            android:id="@+id/et_image_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edt_bg"
            android:hint="Ảnh (URL)"
            android:inputType="textPassword" />

        <EditText
            style="@style/room_update"
            android:id="@+id/et_type_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edt_bg"
            android:hint="Loại phòng"
            android:inputType="textPassword" />

        <EditText
            style="@style/room_update"
            android:id="@+id/et_description_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edt_bg"
            android:hint="Mô tả"
            android:inputType="textPassword" />




        <EditText
            style="@style/room_update"
            android:id="@+id/et_device_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edt_bg"
            android:minHeight="48dp"
            android:hint="Id thiết bị" />



        <Button
            style="@style/save_button"
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tạo mới"
            android:textColor="@android:color/white" />


    </LinearLayout>
</LinearLayout>