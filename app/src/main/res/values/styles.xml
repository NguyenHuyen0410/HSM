<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="bg_main">
        <item name="android:background">
            #FFFFFF
        </item>
    </style>
    <style name="splash_screen">
        <item name="background">@color/white</item>
    </style>

    <!-- Button style -->
    <style name="edit_button">
        <item name="android:textSize">10sp</item>
        <item name="android:text">Edit</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#51719C</item>
        <item name="strokeColor">#224675</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">5dp</item>
    </style>

    <!-- Button style -->
    <style name="logout_button">
        <item name="android:textSize">10sp</item>
        <item name="android:text">Edit</item>
        <item name="android:textColor">#51719C</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#E0E4EA</item>
        <item name="strokeColor">#B2C0D3</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">5dp</item>
    </style>

    <style name="set_delete_button">
        <item name="android:textSize">10sp</item>
        <item name="android:text">Set Delete</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#EABCB9</item>
        <item name="strokeColor">#F44336</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">5dp</item>
    </style>

    <style name="save_button">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:backgroundTint">#09304F</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="add_account_button">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:backgroundTint">#683BCF</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="back_button">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:backgroundTint">#5A9ACD</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="edit_account_input">
        <item name="android:background">#FFFFFF</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColorHint">#C1C6CA</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">20dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_marginBottom">15dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <style name="field_style">
        <item name="android:textColor">#929292</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="field_content_style">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="profile_edit_text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_transparent_input</item>
        <item name="android:hint">Tên</item> <!-- Default hint, can be overridden -->
        <item name="android:inputType">text</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#929292</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>